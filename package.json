{
  "name": "oud-erp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build --webpack",
    "start": "node scripts/start.mjs",
    "lint": "eslint src tests --quiet",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "db:clean-test": "tsx scripts/clean-test-data.ts",
    "db:migrate": "prisma migrate deploy",
    "backup": "node scripts/backup.mjs",
    "cf:build": "node scripts/build-cloudflare.mjs",
    "cf:preview": "npm run cf:build && wrangler dev",
    "cf:deploy": "node scripts/check-cloudflare-config.mjs && npm run cf:build && wrangler deploy",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .worker-dist",
    "test:workers": "node scripts/worker-smoke.mjs",
    "db:generate": "prisma generate && node scripts/generate-model-metadata.mjs",
    "release:source": "node scripts/export-source.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.14",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "decimal.js": "^10.4.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "swr": "2.5.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.155.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  }
}
