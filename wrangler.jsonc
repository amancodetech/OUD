{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oud",
  "main": "cloudflare/worker.mjs",
  "minify": true,
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "badf0348fe1d4cbcacf6b9be47c57ba7",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/postgres"
    }
  ],
  "vars": {
    "APP_URL": "https://configure-your-domain.invalid",
    "SESSION_SECRET": "c7e8a94b5f123d4e6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f"
  }
}
