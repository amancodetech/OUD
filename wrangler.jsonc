{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oud-erp",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "oud-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "oud-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 1
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "JOB_FILES",
      "bucket_name": "oud-private-jobs"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "limits": {
    "cpu_ms": 300000
  },
  "vars": {
    "APP_URL": "https://configure-your-domain.invalid"
  }
}
