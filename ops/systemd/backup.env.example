# Store outside the repository as ~/.config/oud/backup.env, chmod 600.
# Explicitly configure a destination outside this computer; initialize its restic
# repository separately and retain its recovery password outside this computer.
BACKUP_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
BACKUP_DIR=/home/USER/backups/oud-staging
BACKUP_STATUS_FILE=/home/USER/backups/oud-status.json
BACKUP_RETENTION_DAYS=30
RESTIC_REPOSITORY=REPLACE_WITH_EXTERNAL_REPOSITORY
RESTIC_PASSWORD_FILE=/home/USER/.config/oud/restic-password
BACKUP_REMOTE_KEEP_DAILY=30
BACKUP_REMOTE_KEEP_MONTHLY=12
BACKUP_MAX_AGE_HOURS=26
